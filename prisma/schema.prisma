generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrate/introspect must bypass transaction pooler (6543) — avoids
  // "prepared statement already exists" with Supabase Supavisor/PgBouncer.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  superadmin
  operator
}

enum UserStatus {
  pending
  active
  disabled
}

enum MeetupType {
  monthly
  class
}

enum ContentStatus {
  draft
  published
}

enum ContactType {
  partnership
  education
  community
  other
}

enum ContactStatus {
  new
  seen
  done
}

enum AdminInviteStatus {
  pending
  accepted
  cancelled
  expired
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(operator)
  status       UserStatus @default(pending)
  permPeople   Boolean    @default(false)
  permMeetups  Boolean    @default(false)
  permInsights Boolean    @default(false)
  permContact  Boolean    @default(false)
  permSettings Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  invitesSent     AdminInvite[] @relation("InvitesSent")
  inviteAccepted  AdminInvite[] @relation("InviteAccepted")
  mediaAssets     MediaAsset[]
}

model Member {
  id           String      @id @default(cuid())
  nameKr       String
  nameEn       String
  bio          String
  photoUrl     String?
  photoAssetId String?
  photoAsset   MediaAsset? @relation(fields: [photoAssetId], references: [id], onDelete: SetNull)
  linkedinUrl  String?
  websiteUrl   String?
  sortOrder    Int         @default(0)
  isFounder    Boolean     @default(false)
  isVisible    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Meetup {
  id            String         @id @default(cuid())
  type          MeetupType
  title         String
  date          DateTime
  headcount     Int?
  summary       String?
  testimonials  Json?
  status        ContentStatus  @default(draft)
  photos        MeetupPhoto[]
  archivePhotos ArchivePhoto[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MeetupPhoto {
  id       String @id @default(cuid())
  meetupId String
  meetup   Meetup @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  imageUrl String
  sortOrder Int   @default(0)

  @@index([meetupId])
}

model ArchivePhoto {
  id        String   @id @default(cuid())
  imageUrl  String
  meetupId  String?
  meetup    Meetup?  @relation(fields: [meetupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([meetupId])
}

model InsightPost {
  id           String        @id @default(cuid())
  title        String
  category     String
  summary      String
  body         String
  thumbnailUrl String?
  author       String
  publishedAt  DateTime?
  isFeatured   Boolean       @default(false)
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ContactSubmission {
  id        String        @id @default(cuid())
  type      ContactType
  name      String
  org       String?
  email     String
  message   String
  status    ContactStatus @default(new)
  memo      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  publicId     String?
  width        Int?
  height       Int?
  alt          String?
  module       String?
  folder       String?
  mimeType     String?
  byteSize     Int?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  members      Member[]

  @@index([module, createdAt])
}

// Distributed rate-limit counter (fixed window). Shared across serverless
// isolates so limits survive multi-instance / cold-start bypass, unlike the
// in-memory fallback in src/lib/security/rate-limit.ts.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model TranslationCache {
  id              String   @id @default(cuid())
  sourceHash      String
  sourceLang      String   @default("ko")
  targetLang      String
  sourceText      String
  translatedText  String
  provider        String   @default("gemini")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceHash, targetLang])
  @@index([targetLang])
}

model AdminInvite {
  id             String            @id @default(cuid())
  email          String
  role           UserRole
  permPeople     Boolean           @default(false)
  permMeetups    Boolean           @default(false)
  permInsights   Boolean           @default(false)
  permContact    Boolean           @default(false)
  permSettings   Boolean           @default(false)
  tokenHash      String            @unique
  status         AdminInviteStatus @default(pending)
  expiresAt      DateTime
  invitedById    String
  invitedBy      User              @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedUserId String?
  acceptedUser   User?             @relation("InviteAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  lastSentAt     DateTime
  sendCount      Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([email, status])
  @@index([status, expiresAt])
}
