DATABASE_URL="postgresql://aic:aic@localhost:5433/aic_seoul?schema=public"
# Local: same as DATABASE_URL. Production (Vercel→Railway): set BOTH to the Railway
# Postgres *public* URL (identical values). Do not use Supabase :6543/pgbouncer URLs.
DIRECT_URL="postgresql://aic:aic@localhost:5433/aic_seoul?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Public site origin for SEO/canonical/OG (planned prod: https://aic.kr)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Residual Supabase client env (optional / unused for Auth — Auth.js owns auth).
# Kept for compatibility; hosted Postgres SoT is Railway. Do not remove these keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPERADMIN_EMAILS="admin1@aic-seoul.example,admin2@aic-seoul.example,admin3@aic-seoul.example"
SUPERADMIN_SEED_PASSWORD="ChangeMeNow!1"
# Production seed: min 12 chars, not ChangeMeNow!1. Change SuperAdmin password after seed; prefer removing this env from long-lived Production.
# When set, /admin/signup requires this invite code. In production this is REQUIRED:
# if empty, signup is disabled (fail-closed). Empty is dev-only (open signup + pending approval).
ADMIN_SIGNUP_INVITE_CODE=
CONTACT_EMAIL_PLACEHOLDER="hello@aic-seoul.example"

# P4 — optional in dev. In production, Cloudinary is REQUIRED for uploads:
# without it uploads are rejected (503) since local disk is ephemeral on Vercel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aic-seoul
# Optional SDK URL form (contains secret — never commit real values)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
RESEND_API_KEY=
RESEND_FROM="AIC Seoul <onboarding@resend.dev>"
NOTIFY_EMAILS=

# i18n — Gemini (CMS auto-translate; missing key → source-language fallback)
GEMINI_API_KEY=
GEMINI_TRANSLATE_MODEL="gemini-3.5-flash"
