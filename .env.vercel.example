# Runtime (Transaction pooler). Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Migrations (Session pooler or db.*:5432). Required — do not use :6543 here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://YOUR-PROJECT.vercel.app"

# Public site origin for SEO/canonical/OG
# Production: https://aic.kr (until DNS: https://YOUR-PROJECT.vercel.app)
NEXT_PUBLIC_SITE_URL="https://YOUR-PROJECT.vercel.app"

SUPERADMIN_EMAILS="you@example.com,ops@example.com"
SUPERADMIN_SEED_PASSWORD="ReplaceWithStrongTempPass1"
# Optional: require invite code on /admin/signup when set
ADMIN_SIGNUP_INVITE_CODE=

# Supabase Postgres project URL/keys (aic-seoul). Auth is Auth.js — not required for admin gate.
# Do not use POSTGRES_* from a different Vercel↔Supabase Marketplace project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

CONTACT_EMAIL_PLACEHOLDER="hello@aic-seoul.example"

# Recommended on Vercel (ephemeral disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aic-seoul
# Optional: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

RESEND_API_KEY=
RESEND_FROM="AIC Seoul <onboarding@resend.dev>"
NOTIFY_EMAILS=

# i18n — Gemini (CMS auto-translate; missing key → source-language fallback)
GEMINI_API_KEY=
GEMINI_TRANSLATE_MODEL="gemini-3.5-flash"

# Optional production seed overrides
# SEED_STATS_MEMBERS=250K+
# SEED_STATS_CITIES=200+
# SEED_STATS_COUNTRIES=50+
# SEED_CONTACT_SLA=3~5일
# SEED_LINKEDIN_URL=
# SEED_MEETUP_CTA=/contact
